# --- [ Gradle ] ---
.gradle
**/build/
!**/src/**/build/
/bin/
bin/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# --- [ Mod toolchains ] ---
# fabric-loom and ModDevGradle generate a development game directory and a
# decompilation cache. Both are large and neither is reproducible output.
run/
runs/
.architectury-transformer/
remappedSrc/

# --- [ Java ] ---
*.class
*.log
*.war
*.zip

