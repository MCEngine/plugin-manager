{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${version}",
  "name": "${modName}",
  "description": "Client half of MCPluginManager. Sends actions to the server over a plugin message channel.",
  "authors": ["${author}"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["${entrypoint}"]
  },
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "minecraft": "~${minecraft}"
  }
}
